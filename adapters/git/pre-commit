#!/usr/bin/env bash
# prof-DA Layer-3 git gate. Install: copy to .git/hooks/pre-commit and `chmod +x`.
# Blocks a commit until the project's deliverables are proven (evidence-based-done) AND the project's
# requirement monitor has no OPEN ask left un-cleared by a fresh all-MET review receipt.
ROOT="$(git rev-parse --show-toplevel)"
GATE="${PROFDA_GATE:-$ROOT/adapters/gate.py}"   # set PROFDA_GATE to the plugin's adapters/gate.py if out-of-tree
RECEIPT="$ROOT/.prof-da/pending-validation.json"
if [ -f "$GATE" ]; then
  python "$GATE" "$RECEIPT" || { echo "[prof-DA gate] not proven - commit aborted (build/reconcile, then retry)"; exit 1; }
fi
exit 0
